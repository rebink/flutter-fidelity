{
  "name": "flutter-fidelity",
  "version": "0.9.0",
  "description": "One Flutter UI skill with widget reuse, visual verification and MCP tools for Pi and other coding agents",
  "keywords": [
    "pi-package",
    "pi-extension",
    "flutter",
    "visual-testing",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebink/flutter-fidelity.git"
  },
  "homepage": "https://github.com/rebink/flutter-fidelity#readme",
  "pi": {
    "extensions": [
      "./extensions/flutter-fidelity.js"
    ],
    "skills": [
      "./skills/flutter-ui"
    ]
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "flutter-fidelity": "dist/cli.js"
  },
  "files": [
    "dist",
    "extensions",
    "figma-plugin",
    "src",
    "tsconfig.json",
    "skills",
    "flutter/fidelity_harness/lib",
    "flutter/fidelity_harness/pubspec.yaml",
    "docs",
    "examples",
    "scripts/version.mjs",
    "scripts/prepare-figma-plugin.mjs",
    "scripts/update.mjs",
    "CHANGELOG.md",
    "plugin.json",
    "mcp.json",
    ".codex-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "npm run version:check && npm test",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs",
    "release:version": "node scripts/version.mjs",
    "update:check": "node scripts/update.mjs --check",
    "update": "node scripts/update.mjs",
    "fixtures": "tsx scripts/fixtures.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepack": "npm run version:check && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^14.0.0",
    "pixelmatch": "8.0.0",
    "sharp": "0.35.5",
    "ssim.js": "3.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts"
}
