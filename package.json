{
  "name": "flutter-fidelity",
  "version": "0.1.0",
  "description": "Screenshot-first Flutter UI agent tools, visual verification and MCP",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flutter-fidelity": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "flutter/fidelity_harness/lib",
    "flutter/fidelity_harness/pubspec.yaml",
    "docs",
    "examples",
    "plugin.json",
    "mcp.json",
    ".codex-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "npm test",
    "fixtures": "tsx scripts/fixtures.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^14.0.0",
    "pixelmatch": "8.0.0",
    "sharp": "0.35.5",
    "ssim.js": "3.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts"
}
